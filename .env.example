# Server-only. Never use VITE_ for these values.
DISCORD_CLIENT_ID=1570103248453509281
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
# Comma-separated Discord user IDs for owner/admin access.
DISCORD_ADMIN_IDS=
# Optional: enable server-role-based staff access.
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_MOD_ROLE_IDS=
# Production transaction-pooler URI, including URL-encoded database password.
DATABASE_URL=
# Generate separately from SESSION_SECRET; keep stable while webhooks exist.
WEBHOOK_ENCRYPTION_KEY=
# Optional PEM certificate if the database CA is not in Node's trust store.
DATABASE_CA_CERT=
