{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/featured/manage",
      "destination": "/index.html"
    },
    {
      "source": "/archive",
      "destination": "/index.html"
    },
    {
      "source": "/archive/manage",
      "destination": "/index.html"
    },
    {
      "source": "/reply/:token",
      "destination": "/index.html"
    },
    {
      "source": "/membership",
      "destination": "/index.html"
    },
    {
      "source": "/merch",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:section",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:section/:subsection",
      "destination": "/index.html"
    },
    {
      "source": "/projects",
      "destination": "/index.html"
    },
    {
      "source": "/projects/:id",
      "destination": "/index.html"
    },
    {
      "source": "/my-projects",
      "destination": "/index.html"
    },
    {
      "source": "/members",
      "destination": "/index.html"
    },
    {
      "source": "/community",
      "destination": "/index.html"
    },
    {
      "source": "/c/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/members/:id",
      "destination": "/index.html"
    },
    {
      "source": "/posts/:id",
      "destination": "/index.html"
    },
    {
      "source": "/inbox",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/reclamation",
      "destination": "https://thecompound.cultofnixon.com/operations",
      "permanent": true
    },
    {
      "source": "/facility/control",
      "destination": "https://thecompound.cultofnixon.com/overseer/supplies",
      "permanent": true
    },
    {
      "source": "/facility",
      "destination": "https://thecompound.cultofnixon.com/supplies",
      "permanent": true
    },
    {
      "source": "/out/:id",
      "destination": "/posts/:id",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "c0n.ivansays.com"
        }
      ],
      "destination": "https://cultofnixon.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "c0n.ivansays.com"
        }
      ],
      "destination": "https://cultofnixon.com/:path*",
      "permanent": true
    }
  ]
}
